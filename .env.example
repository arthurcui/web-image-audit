# Copy to .env and explicitly approve your page and image hosts.
# Empty means deny all. Example: cnbible.com,www.cnbible.com
AUDIT_APPROVED_HOSTS=
AUDIT_DB_PATH=data/audits.sqlite
# Never add bearer tokens or VITE_ prefixed secrets here.
# Fallback absolute path when data/browser-runtime.json has not been created by npm run browser:install.
# AUDIT_BROWSER_EXECUTABLE=C:/path/to/chrome.exe
