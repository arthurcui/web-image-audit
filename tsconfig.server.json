{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist/server",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/api/**/*.ts",
    "src/application/**/*.ts",
    "src/cli/**/*.ts",
    "src/demo/**/*.ts",
    "src/infrastructure/**/*.ts",
    "src/mcp/**/*.ts",
    "src/shared/**/*.ts",
    "src/worker/**/*.ts"
  ]
}
