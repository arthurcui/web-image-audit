{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "lib": [
      "ES2023"
    ],
    "rootDir": "src",
    "outDir": "dist/server"
  },
  "include": [
    "src/api/**/*.ts",
    "src/application/**/*.ts",
    "src/shared/**/*.ts",
    "src/infrastructure/**/*.ts",
    "src/worker/**/*.ts",
    "src/mcp/**/*.ts",
    "src/demo/**/*.ts"
  ]
}
