{
  "name": "website-image-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch src/api/main.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.tools.json",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "start:api": "node --env-file-if-exists=.env dist/server/api/main.js",
    "preview": "vite preview",
    "test": "tsx --test tests/*/*.test.ts",
    "check": "npm run lint && npm run format:check && npm run check:boundaries && npm test && npm run build",
    "browser:install": "node scripts/install-browser.mjs",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/worker/main.ts",
    "start:worker": "node --env-file-if-exists=.env dist/server/worker/main.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/cli/migrate.ts",
    "auth:token": "node --env-file-if-exists=.env --import tsx src/cli/provision-token.ts",
    "test:ui": "playwright test",
    "check:all": "npm run check && npm run test:ui",
    "dev:mcp": "node --env-file-if-exists=.env --import tsx src/mcp/main.ts",
    "start:mcp": "node --env-file-if-exists=.env dist/server/mcp/main.js",
    "test:mcp": "tsx --test tests/mcp/protocol.test.ts",
    "demo": "node scripts/demo.mjs",
    "demo:token": "node scripts/demo.mjs token",
    "demo:mcp": "node scripts/demo.mjs mcp",
    "test:unit": "tsx --test tests/web/*.test.ts tests/api/health-contract.test.ts tests/mcp/demo-command.test.ts",
    "test:integration": "tsx --test tests/engine/*.test.ts tests/jobs/*.test.ts tests/authorization/*.test.ts tests/architecture/*.test.ts tests/api/contracts.test.ts tests/api/health.test.ts tests/api/demo.test.ts tests/mcp/protocol.test.ts tests/mcp/bridge.test.ts",
    "check:boundaries": "depcruise --config .dependency-cruiser.json src",
    "lint": "oxlint --deny-warnings src tests scripts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "fastify": "5.12.7",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.18",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "dependency-cruiser": "18.7.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
